# Copy this file to .env and fill in the two keys and the salt. Never commit .env (it is in
# .gitignore).

# Free key from https://developer-apim.aeso.ca/
AESO_PRIMARY_API_KEY=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any long random string, for example the output of:  openssl rand -hex 16
# It salts the hashed visitor addresses behind the daily question limit. Left empty, a new
# salt is drawn at every start and the day's counts reset.
IP_SALT=

# The local database that docker-compose.yml starts, and the read-only role that
# db/002_readonly_user.sql creates in it. `ingest.migrate` gives that role whatever password
# the second URL says, so a hosted database puts a strong one here. Anything hosted sets its own.
DATABASE_URL=postgresql://aea:aea@127.0.0.1:5432/aea
DATABASE_URL_READONLY=postgresql://app_readonly:app_readonly@127.0.0.1:5432/aea

# Optional. Defaults and meanings are in docs/running-locally.md.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.6-flash
# RATE_LIMIT_PER_DAY=10
# REPO_URL=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 behind a reverse proxy (any hosting service, Azure Container Apps included), never
# without one.
# TRUST_PROXY=1
